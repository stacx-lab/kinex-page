---
// Frozen v1.0 documentation. Each page links to its current replacement.
import Doc from '../../../layouts/Doc.astro';
import { render } from 'astro:content';
import { getDocs, docSlug, successor, type Doc as DocEntry } from '../../../lib/content';
import { url } from '../../../lib/url';

export async function getStaticPaths() {
  const docs = await getDocs('docsV1_0');
  const current = new Set((await getDocs()).map((d) => d.id));
  return docs.map((entry) => ({
    params: { slug: docSlug(entry) },
    props: { entry, docs, latest: successor(entry.id, current) ?? url('/docs/') },
  }));
}

interface Props { entry: DocEntry; docs: DocEntry[]; latest: string }
const { entry, docs, latest } = Astro.props;
const { Content, headings } = await render(entry);
---
<Doc docs={docs} entry={entry} title={entry.data.title} description={entry.data.description} headings={headings} collection="docsV1_0" latest={latest}>
  <Content />
</Doc>
