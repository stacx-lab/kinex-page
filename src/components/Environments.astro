---
// Where the devices come from: kinex-sim's simulators, real robots, and the hosts Kinex runs in.
// Simulator rows mirror the table in kinex/README.md.
import { site } from '../config';
import { url } from '../lib/url';

const simulators = [
  { id: 'abc', name: 'ABC', robot: 'Two YAM arms', tasks: 33 },
  { id: 'libero', name: 'LIBERO', robot: 'Franka Panda', tasks: 130 },
  { id: 'robotwin', name: 'RoboTwin 2.0', robot: 'ALOHA AgileX, two arms', tasks: 50 },
  { id: 'robodojo', name: 'RoboDojo', robot: 'Two ARX X5 arms', tasks: 42 },
  { id: 'robocasa', name: 'RoboCasa', robot: 'Panda on an Omron mobile base', tasks: 365 },
  { id: 'behavior', name: 'BEHAVIOR', robot: 'R1Pro mobile manipulator', tasks: 100 },
  { id: 'handson', name: 'HandsOn', robot: 'Two ROKAE AR5 arms, Wuji hands', tasks: 66 },
  { id: 'bidex', name: 'BiDex-100', robot: 'FR3v2 or Astribot S1, Sharpa hands', tasks: 106 },
];
const total = simulators.reduce((sum, simulator) => sum + simulator.tasks, 0);
const most = Math.max(...simulators.map((simulator) => simulator.tasks));
const robots = [
  { name: 'YAM ABC Box', kind: 'Dual arm' },
  { name: 'xArm 7', kind: 'Single arm' },
  { name: 'Dexteleop TeleAvatar', kind: 'Wheeled dual-arm mobile manipulator' },
  { name: 'Unitree Go2 + D1', kind: 'Legged mobile manipulator' },
];
---
<div class="envs">
  <section class="panel sims" aria-labelledby="env-sim">
    <header>
      <p class="label">Simulation · kinex-sim</p>
      <h3 id="env-sim"><strong>{simulators.length}</strong> simulators, <strong>{total}</strong> tasks, one device contract</h3>
    </header>
    <ul class="rows">
      {simulators.map((simulator) => (
        <li>
          <a href={`${site.sim}/blob/main/docs/${simulator.id}.md`}>
            <span class="sim">{simulator.name}</span>
            <span class="robot">{simulator.robot}</span>
            <span class="meter" aria-hidden="true"><i style={`width: ${Math.max(6, Math.sqrt(simulator.tasks / most) * 100)}%`}></i></span>
            <span class="count">{simulator.tasks}<span class="sr-only"> tasks</span></span>
          </a>
        </li>
      ))}
    </ul>
    <dl class="traits">
      <div><dt>One workspace per task</dt><dd>Exported with the task’s devices and calibration, ready to open.</dd></div>
      <div><dt>Stepped or realtime</dt><dd>In stepped mode the world waits while the agent thinks.</dd></div>
      <div><dt>Judged natively</dt><dd>Each benchmark’s own success criteria, hidden from the agent.</dd></div>
    </dl>
    <pre class="cmds" aria-label="Three commands from task to session"><code><span class="p">$</span> kinex-sim setup  libero/libero-spatial-01 --directory ws --domain-id 83
<span class="p">$</span> kinex-sim launch libero/libero-spatial-01 --execution-mode stepped --domain-id 83
<span class="p">$</span> cd ws && kinex</code></pre>
    <a class="more" href={url('/docs/simulators/')}>Run your first simulated task →</a>
  </section>

  <div class="side">
    <section class="panel" aria-labelledby="env-real">
      <header>
        <p class="label">Real robots</p>
        <h3 id="env-real">Describe the hardware. The agent builds its own interface.</h3>
      </header>
      <p class="prompt"><span class="p">›</span> /onboarding Set up my arm, gripper and overhead camera to pick objects from the table.</p>
      <ul class="robots">
        {robots.map((robot) => <li><b>{robot.name}</b><span>{robot.kind}</span></li>)}
      </ul>
      <p class="note">Shown in the gallery above. Robots that already run ROS 2 Jazzy or Humble keep their drivers.</p>
      <a class="more" href={url('/docs/real-robots/')}>Connect a real robot →</a>
    </section>

    <section class="panel" aria-labelledby="env-host">
      <header>
        <p class="label">Hosts</p>
        <h3 id="env-host">Standalone, or inside the agent you already use.</h3>
      </header>
      <ul class="hosts">
        <li><span class="chip">Kinex</span><span>the standalone app, built on Pi</span></li>
        <li><span class="chip">Pi</span><span class="chip">Claude Code</span><span class="chip">Codex</span><span>through kinex-plugins</span></li>
      </ul>
      <a class="more" href={url('/docs/plugins/#using-kinex-from-other-harnesses')}>Use Kinex as a plugin →</a>
    </section>
  </div>
</div>

<style>
  .envs { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 20px; align-items: stretch; }
  .side { display: grid; gap: 20px; align-content: stretch; }
  .panel { min-width: 0; display: flex; flex-direction: column; padding: 24px; border: 1px solid var(--rule); border-radius: 14px; background: var(--panel); }
  .sims { background: var(--wash); border-color: color-mix(in srgb, var(--accent) 28%, var(--rule)); }
  header { margin-bottom: 16px; }
  .label { margin: 0 0 8px; }
  h3 { margin: 0; font-size: 20px; line-height: 1.3; font-weight: 600; letter-spacing: -0.015em; text-wrap: balance; }
  h3 strong { color: var(--accent-ink); font-weight: 600; }

  .rows { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--rule); }
  .rows a {
    display: grid; grid-template-columns: 112px minmax(0, 1fr) 88px 34px; gap: 12px; align-items: center;
    padding: 8px 6px; border-bottom: 1px solid var(--rule); font-size: 14.5px; transition: background .12s;
  }
  .rows a:hover { background: color-mix(in srgb, var(--accent) 7%, transparent); }
  .sim { font-family: var(--font-mono); letter-spacing: var(--tracking); font-size: 13px; font-weight: 700; }
  .robot { color: var(--ink-2); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .meter { height: 5px; border-radius: 3px; background: color-mix(in srgb, var(--ink) 8%, transparent); }
  .meter i { display: block; height: 100%; border-radius: inherit; background: var(--accent); }
  .count { font-family: var(--font-mono); font-size: 12.5px; text-align: right; font-variant-numeric: tabular-nums; color: var(--ink-2); }

  .traits { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; margin: 18px 0 0; }
  .traits dt { font-weight: 700; font-size: 14px; line-height: 1.35; }
  .traits dd { margin: 3px 0 0; font-size: 13px; line-height: 1.5; color: var(--ink-2); }
  @media (max-width: 560px) { .traits { grid-template-columns: minmax(0, 1fr); gap: 10px; } }
  .cmds {
    margin: 18px 0 0; padding: 12px 14px; overflow-x: auto; scrollbar-width: thin;
    font-size: 12px; line-height: 1.7; color: var(--term-ink); background: var(--term-bg); border-radius: 8px;
  }
  .p { color: var(--accent); user-select: none; }
  :global(:root[data-theme='light']) .cmds .p { color: #a49ef7; }
  .more { margin-top: auto; padding-top: 16px; font-size: 14.5px; font-weight: 700; color: var(--accent-ink); }
  .more:hover { text-decoration: underline; text-underline-offset: 3px; }

  .prompt {
    margin: 0 0 14px; padding: 10px 12px; font-family: var(--font-mono); letter-spacing: var(--tracking); font-size: 12.5px; line-height: 1.6;
    border: 1px solid var(--rule); border-left: 2px solid var(--devices); border-radius: 0 8px 8px 0; background: var(--bg);
  }
  .robots { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px 16px; }
  .robots li { display: grid; gap: 1px; font-size: 13px; line-height: 1.4; }
  .robots b { font-weight: 700; font-size: 14.5px; }
  .robots span { color: var(--ink-2); }
  .note { margin: 14px 0 0; font-size: 13.5px; line-height: 1.55; color: var(--ink-2); }
  .hosts { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; font-size: 14px; color: var(--ink-2); }
  .hosts li { display: flex; flex-wrap: wrap; gap: 6px 8px; align-items: center; }

  @media (max-width: 900px) { .envs { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 560px) {
    .panel { padding: 18px 16px; }
    .rows a { grid-template-columns: 96px minmax(0, 1fr) 34px; }
    .meter { display: none; }
  }
</style>
