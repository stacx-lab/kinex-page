---
// One exec program, annotated: selecting a step lights up the lines that carry it out.
// The program is the one explained in /docs/control-graph/.
import { Code } from 'astro:components';
import { url } from '../lib/url';

const code = `import asyncio
import numpy as np
from kinex import args, finish, io, lib

async def main():
    target = args()["target"]
    arm = lib.kinematics.joint_model("arm")

    state = await io.read("arm.joint_state")
    plan = lib.motion.trajectory(arm.joints, state.position, target,
                                 period_s=0.02)
    step = plan.duration_s / len(plan.actions)
    await io.publish("arm.joint_target", {"joint_names": arm.names, "points": [
        {"positions": q, "time_from_start": (i + 1) * step}
        for i, q in enumerate(plan.actions)]})
    await io.request("world.wait", duration_s=plan.duration_s + 0.2)

    reached = await io.read("arm.joint_state")
    error = float(np.abs(np.asarray(reached.position) - target).max())
    image, _ = await lib.images.camera_frame("camera_wrist")
    finish({"max_error_rad": error}, file=[image])

asyncio.run(main())`;

// Lines are 1-based and inclusive.
const steps = [
  { id: 'observe', name: 'Observe', lines: [9, 9], text: 'Read the arm’s measured joint state. Messages are the ROS types its profile declares.' },
  { id: 'compute', name: 'Compute', lines: [10, 12], text: 'Plan a trajectory within the arm’s velocity limits, using the function library.' },
  { id: 'command', name: 'Command', lines: [13, 15], text: 'Publish the trajectory to the arm’s command topic.' },
  { id: 'wait', name: 'Wait', lines: [16, 16], text: 'Let world time pass. In a stepped simulation, nothing else advances it.' },
  { id: 'verify', name: 'Verify', lines: [18, 20], text: 'A sent command is not an arrival: read fresh feedback and take a picture.' },
  { id: 'report', name: 'Report', lines: [21, 21], text: 'Finish with a small result and the image. The agent decides what comes next.' },
];
---
<div class="loop" data-loop>
  <ol class="steps">
    {steps.map((step, i) => (
      <li>
        <button type="button" class:list={['step', { on: i === 0 }]} data-step={step.id} data-from={step.lines[0]} data-to={step.lines[1]} aria-pressed={i === 0 ? 'true' : 'false'}>
          <span class="idx">{i + 1}</span>
          <span class="name">{step.name}</span>
          <span class="text">{step.text}</span>
        </button>
      </li>
    ))}
  </ol>
  <figure class="window">
    <figcaption>
      <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="file"><b>exec</b> move the arm and check arrival</span>
      <a href={url('/docs/control-graph/#a-program')}>Explained in the docs →</a>
    </figcaption>
    <div class="source" tabindex="0" aria-label="An exec program">
      <Code code={code} lang="python" themes={{ light: 'min-light', dark: 'min-dark' }} defaultColor={false} />
    </div>
    <p class="result"><span class="ok">✓</span> <span class="dim">returns, for example,</span> {'{"max_error_rad": 0.0018}'} <span class="dim">and one image</span></p>
  </figure>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-loop]').forEach((loop) => {
    const lines = [...loop.querySelectorAll<HTMLElement>('.source .line')];
    const steps = [...loop.querySelectorAll<HTMLButtonElement>('[data-step]')];
    const select = (step: HTMLButtonElement) => {
      const from = Number(step.dataset.from), to = Number(step.dataset.to);
      steps.forEach((other) => { other.classList.toggle('on', other === step); other.setAttribute('aria-pressed', String(other === step)); });
      lines.forEach((line, index) => line.classList.toggle('hot', index + 1 >= from && index + 1 <= to));
      loop.classList.add('picked');
    };
    steps.forEach((step) => {
      step.addEventListener('click', () => select(step));
      step.addEventListener('pointerenter', () => select(step));
      step.addEventListener('focus', () => select(step));
    });
    if (steps[0]) select(steps[0]);
  });
</script>

<style>
  .loop { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 8fr); gap: 28px; align-items: start; }
  .steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .step {
    display: grid; grid-template-columns: 26px minmax(0, 1fr); gap: 2px 12px; width: 100%; text-align: left;
    padding: 11px 14px; font: inherit; color: inherit; cursor: pointer;
    background: none; border: 1px solid transparent; border-radius: 10px; transition: background .15s, border-color .15s;
  }
  .idx {
    grid-row: 1 / 3; display: grid; place-items: center; width: 26px; height: 26px; margin-top: 1px;
    font-family: var(--font-mono); font-size: 12px; color: var(--ink-3); border: 1px solid var(--rule-2); border-radius: 50%;
  }
  .name { font-family: var(--font-head); font-weight: 600; font-size: 16.5px; line-height: 1.5; }
  .text { font-size: 14.5px; line-height: 1.5; color: var(--ink-2); }
  .step:hover { background: var(--panel); }
  .step.on { background: var(--panel); border-color: color-mix(in srgb, var(--graph) 45%, var(--rule)); box-shadow: var(--shadow); }
  .step.on .idx { color: var(--panel); background: var(--graph); border-color: var(--graph); }

  .window { margin: 0; min-width: 0; border: 1px solid var(--rule-2); border-radius: 12px; background: var(--panel); overflow: hidden; box-shadow: var(--shadow); }
  figcaption {
    display: flex; align-items: center; gap: 12px; height: 38px; padding: 0 14px; border-bottom: 1px solid var(--rule);
    background: var(--bg-2); font-family: var(--font-mono); font-size: 11.5px; letter-spacing: var(--tracking); color: var(--ink-2);
  }
  .dots { display: flex; gap: 5px; flex: none; }
  .dots i { width: 7px; height: 7px; border-radius: 50%; background: var(--rule-2); }
  .file { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .file b { color: var(--graph); font-weight: 700; margin-right: 6px; }
  figcaption a { margin-left: auto; flex: none; color: var(--ink-3); }
  figcaption a:hover { color: var(--accent); }
  .source { overflow-x: auto; scrollbar-width: thin; }
  .source :global(pre) {
    margin: 0; padding: 14px 0; font-size: 12.5px; line-height: 1.62; background: none !important;
    min-width: max-content;
  }
  .source :global(.line) { display: inline-block; width: 100%; padding: 0 16px; border-left: 2px solid transparent; transition: background .15s, opacity .15s; }
  .source :global(pre), .source :global(pre span) { color: var(--shiki-light); }
  :global(:root[data-theme='dark']) .source :global(pre), :global(:root[data-theme='dark']) .source :global(pre span) { color: var(--shiki-dark); }
  .loop.picked .source :global(.line) { opacity: 0.55; }
  .loop.picked .source :global(.line.hot) { opacity: 1; background: color-mix(in srgb, var(--graph) 10%, transparent); border-left-color: var(--graph); }
  .result {
    margin: 0; padding: 9px 16px; border-top: 1px solid var(--rule); background: color-mix(in srgb, var(--devices) 7%, var(--panel));
    font-family: var(--font-mono); font-size: 12px; letter-spacing: var(--tracking); overflow-wrap: anywhere;
  }
  .ok { color: var(--devices); }
  @media (max-width: 900px) {
    .loop { grid-template-columns: minmax(0, 1fr); }
    .steps { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .text { display: none; }
    .step { grid-template-columns: 26px minmax(0, 1fr); align-items: center; padding: 8px 10px; }
    .idx { grid-row: auto; }
    figcaption a { display: none; }
  }
  @media (max-width: 480px) { .source :global(pre) { font-size: 11px; } }
</style>
